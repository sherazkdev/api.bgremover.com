NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_PREFIX=/api/v1

PUBLIC_BASE_URL=http://localhost:3000

# Production behind nginx (deploy/background-remover-api):
# NODE_ENV=production
# HOST=127.0.0.1
# PORT=3014
# PUBLIC_BASE_URL=http://bgremove.recipehubapi.com
UPLOAD_ROOT=public/uploads

MAX_FILE_SIZE_MB=10
MAX_BULK_IMAGES=8
MAX_IMAGE_WIDTH=6000
MAX_IMAGE_HEIGHT=6000
MAX_IMAGE_PIXELS=25000000

BG_REMOVAL_CONCURRENCY=1
BG_REMOVAL_QUEUE_LIMIT=20

# Photo portraits: birefnet (default ONNX path) or inspyrenet (local Python worker on loopback).
REMOVAL_PHOTO_ENGINE=birefnet
# When REMOVAL_PHOTO_ENGINE=inspyrenet, start: npm run worker:inspyrenet
INSPIRENET_WORKER_URL=http://127.0.0.1:8765
INSPIRENET_WORKER_TIMEOUT_MS=180000
# CPU inference threads (default: all logical cores). Rollback: unset or set to 4.
# INSPIRENET_TORCH_THREADS=8
# INSPIRENET_PNG_COMPRESS_LEVEL=1

MODEL_ID=studioludens/birefnet-lite-512
# Stronger quality (more VRAM/RAM, slower): e.g. ZhengPeng/BiRefNet or other 1024 BiRefNet ONNX repos
# MODEL_ID=ZhengPeng/BiRefNet
MODEL_DTYPE=fp32
API_KEY=change-me-to-a-long-random-secret

RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=1 minute

HF_ENDPOINT=https://huggingface.co

# Optional locally trained refiner (private/models — not in git)
# Optional 64×64 edge refiner — studio/product only; skip on VPS for outdoor portraits (ignored when bg variance > 28).
# MATTE_REFINER_PATH=private/models/matte-refiner.json
