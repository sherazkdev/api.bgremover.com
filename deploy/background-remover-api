map $http_upgrade $bgremover_upgrade {
    default upgrade;
    ""      close;
}

upstream background_remover_api {
    server 127.0.0.1:3014;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name bgremove.recipehubapi.com www.bgremove.recipehubapi.com;

    client_max_body_size 20m;
    client_body_timeout 180s;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        proxy_pass http://background_remover_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $bgremover_upgrade;
        proxy_connect_timeout 10s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
    }
}
