[Unit]
Description=Background Remover API (Fastify :3014)
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/api.bgremover.com
Environment=NODE_ENV=production
Environment=PORT=3014
Environment=HOST=127.0.0.1
Environment=PUBLIC_BASE_URL=http://bgremove.recipehubapi.com
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
